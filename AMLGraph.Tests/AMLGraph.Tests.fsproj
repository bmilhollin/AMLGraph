  <ItemGroup>
    <PackageReference Include="Expecto" Version="11.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" Version="0.16.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AMLGraph.SyntheticData\AMLGraph.SyntheticData.fsproj" />
    <ProjectReference Include="..\AMLGraph.Reporting\AMLGraph.Reporting.fsproj" />
    <ProjectReference Include="..\AMLGraph.Domain\AMLGraph.Domain.fsproj" />
  </ItemGroup>

</Project>
